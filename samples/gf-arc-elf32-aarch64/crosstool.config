CT_CONFIG_VERSION="4"
CT_EXPERIMENTAL=y
CT_PREFIX_DIR="arc-elf32-aarch64"
# CT_LOG_PROGRESS_BAR is not set
CT_ARCH_ARC=y
CT_MULTILIB=y
CT_TARGET_CFLAGS="-g -O2 -ffunction-sections -fdata-sections"
# CT_SHOW_CT_VERSION is not set
CT_TOOLCHAIN_PKGVERSION="ARCompact/ARCv2 elf32 toolchain - build 11025"
CT_TARGET_VENDOR="gf"
CT_TARGET_ALIAS="arc-elf32"
CT_CANADIAN=y
CT_HOST="aarch64-unknown-linux-gnu"
# CT_TOOLCHAIN_CMAKE_TOOLCHAIN_FILE is not set
CT_BINUTILS_SRC_DEVEL=y
CT_BINUTILS_DEVEL_URL="https://github.com/foss-for-mips-arc-processors/binutils-gdb.git"
CT_BINUTILS_DEVEL_REVISION="b30afcc3a8f038dc171269050e3e710bc4460474"
CT_NEWLIB_SRC_DEVEL=y
CT_NEWLIB_DEVEL_URL="https://github.com/foss-for-mips-arc-processors/newlib.git"
CT_NEWLIB_DEVEL_REVISION="22593d34041e84cba6fce725a9129dabdfe1c0f7"
CT_LIBC_NEWLIB_IO_LL=y
CT_LIBC_NEWLIB_IO_FLOAT=y
# CT_LIBC_NEWLIB_ENABLE_TARGET_OPTSPACE is not set
CT_GCC_SRC_DEVEL=y
CT_GCC_DEVEL_URL="https://github.com/foss-for-mips-arc-processors/gcc.git"
CT_GCC_DEVEL_REVISION="6cdd8a9192b5c291d19d2893d6671829077680b7"
# CT_CC_GCC_CONFIG_TLS is not set
# CT_CC_GCC_USE_GRAPHITE is not set
# CT_CC_GCC_USE_LTO is not set
# CT_CC_GCC_ENABLE_TARGET_OPTSPACE is not set
CT_CC_LANG_CXX=y
CT_DEBUG_GDB=y
CT_GDB_SRC_DEVEL=y
CT_GDB_DEVEL_URL="https://github.com/foss-for-mips-arc-processors/binutils-gdb.git"
CT_GDB_DEVEL_REVISION="a476f6d73b2b5d4f76ef0e83584ee20f13b5c8a4"
CT_COMP_LIBS_NEWLIB_NANO=y
CT_NEWLIB_NANO_SRC_DEVEL=y
CT_NEWLIB_NANO_DEVEL_URL="https://github.com/foss-for-mips-arc-processors/newlib.git"
CT_NEWLIB_NANO_DEVEL_REVISION="22593d34041e84cba6fce725a9129dabdfe1c0f7"
CT_LIBC_NEWLIB_NANO_IO_FLOAT=y
# CT_LIBC_NEWLIB_NANO_FVWRITE_IN_STREAMIO is not set
# CT_LIBC_NEWLIB_NANO_ATEXIT_DYNAMIC_ALLOC is not set
# CT_LIBC_NEWLIB_NANO_MULTITHREAD is not set
# CT_LIBICONV_NEEDED is not set
# CT_GETTEXT_NEEDED is not set
