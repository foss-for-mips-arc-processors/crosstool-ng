CT_CONFIG_VERSION="4"
CT_EXPERIMENTAL=y
CT_PREFIX_DIR="arc-elf32-aarch64-picolibc"
# CT_LOG_PROGRESS_BAR is not set
CT_ARCH_ARC=y
CT_MULTILIB=y
CT_TARGET_CFLAGS="-g -O2 -ffunction-sections -fdata-sections -mno-sdata"
# CT_SHOW_CT_VERSION is not set
CT_TOOLCHAIN_PKGVERSION="ARCompact/ARCv2 elf32 picolibc toolchain - build 11025"
CT_TARGET_VENDOR="gf"
CT_TARGET_ALIAS="arc-elf32"
CT_CANADIAN=y
CT_HOST="aarch64-unknown-linux-gnu"
# CT_TOOLCHAIN_CMAKE_TOOLCHAIN_FILE is not set
CT_BINUTILS_SRC_DEVEL=y
CT_BINUTILS_DEVEL_URL="https://github.com/foss-for-mips-arc-processors/binutils-gdb.git"
CT_BINUTILS_DEVEL_REVISION="b30afcc3a8f038dc171269050e3e710bc4460474"
CT_LIBC_PICOLIBC=y
CT_PICOLIBC_SRC_DEVEL=y
CT_PICOLIBC_DEVEL_URL="https://github.com/foss-for-mips-arc-processors/picolibc.git"
CT_PICOLIBC_DEVEL_REVISION="00130fb08451a46d459ca2fd16810995a11192b8"
CT_LIBC_PICOLIBC_IO_LL=y
CT_LIBC_PICOLIBC_EXTRA_SECTIONS=y
CT_LIBC_PICOLIBC_EXTRA_CONFIG_ARRAY="-Dio-long-double=true -Dio-percent-b=true -Dprintf-percent-n=true -Dfast-bufio=true -Dmb-capable=true -Dio-wchar=true -Dposix-console=true -Dnewlib-obsolete-math=false -Dwant-math-errno=true -Dassert-verbose=true -Doptimization=2 -Dthread-local-storage=false"
CT_LIBC_PICOLIBC_DEFAULT_FLASH_ADDR="0x00000000"
CT_LIBC_PICOLIBC_DEFAULT_FLASH_SIZE="128K"
CT_LIBC_PICOLIBC_DEFAULT_RAM_ADDR="0x40000000"
CT_LIBC_PICOLIBC_DEFAULT_RAM_SIZE="128K"
CT_GCC_SRC_DEVEL=y
CT_GCC_DEVEL_URL="https://github.com/foss-for-mips-arc-processors/gcc.git"
CT_GCC_DEVEL_REVISION="6cdd8a9192b5c291d19d2893d6671829077680b7"
CT_CC_GCC_EXTRA_CONFIG_ARRAY="--enable-initfini-array"
# CT_CC_GCC_CONFIG_TLS is not set
# CT_CC_GCC_USE_GRAPHITE is not set
# CT_CC_GCC_USE_LTO is not set
# CT_CC_GCC_ENABLE_TARGET_OPTSPACE is not set
CT_CC_LANG_CXX=y
CT_DEBUG_GDB=y
CT_GDB_SRC_DEVEL=y
CT_GDB_DEVEL_URL="https://github.com/foss-for-mips-arc-processors/binutils-gdb.git"
CT_GDB_DEVEL_REVISION="a476f6d73b2b5d4f76ef0e83584ee20f13b5c8a4"
CT_COMP_LIBS_PICOLIBC_NANO=y
CT_PICOLIBC_NANO_SRC_DEVEL=y
CT_PICOLIBC_NANO_DEVEL_URL="https://github.com/foss-for-mips-arc-processors/picolibc.git"
CT_PICOLIBC_NANO_DEVEL_REVISION="00130fb08451a46d459ca2fd16810995a11192b8"
CT_LIBC_PICOLIBC_NANO_IO_C99FMT=y
CT_LIBC_PICOLIBC_NANO_EXTRA_SECTIONS=y
CT_LIBC_PICOLIBC_NANO_EXTRA_CONFIG_ARRAY="-Dposix-console=true -Dnewlib-obsolete-math=false -Dwant-math-errno=true -Dassert-verbose=true -Doptimization=s -Dthread-local-storage=false"
CT_LIBC_PICOLIBC_NANO_GCC_LIBSTDCXX_TARGET_CXXFLAGS="-fno-exceptions -g"
# CT_LIBICONV_NEEDED is not set
# CT_GETTEXT_NEEDED is not set
