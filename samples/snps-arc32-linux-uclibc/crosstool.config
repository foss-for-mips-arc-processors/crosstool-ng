CT_CONFIG_VERSION="4"
CT_EXPERIMENTAL=y
CT_PREFIX_DIR="arc32-linux-uclibc"
# CT_LOG_PROGRESS_BAR is not set
CT_ARCH_ARC=y
CT_ARCH_ARC_ISA_V3=y
CT_TARGET_CFLAGS="-g -O2 -ffunction-sections -fdata-sections"
# CT_SHOW_CT_VERSION is not set
CT_TOOLCHAIN_PKGVERSION="ARCv3 Linux uclibc toolchain - build 11025"
CT_TARGET_VENDOR="gf"
CT_TARGET_ALIAS_SED_EXPR="s/${CT_TARGET_VENDOR}-//"
CT_TARGET_ALIAS="arc32-linux"
# CT_TOOLCHAIN_CMAKE_TOOLCHAIN_FILE is not set
CT_KERNEL_LINUX=y
CT_LINUX_SRC_DEVEL=y
CT_LINUX_DEVEL_URL="https://github.com/foss-for-mips-arc-processors/linux.git"
CT_LINUX_DEVEL_REVISION="c45ffc99396bcb993013b8da095d68d7d139557e"
CT_BINUTILS_SRC_DEVEL=y
CT_BINUTILS_DEVEL_URL="https://github.com/foss-for-mips-arc-processors/binutils-gdb.git"
CT_BINUTILS_DEVEL_REVISION="b30afcc3a8f038dc171269050e3e710bc4460474"
CT_LIBC_UCLIBC_NG=y
CT_UCLIBC_NG_SRC_DEVEL=y
CT_UCLIBC_NG_DEVEL_URL="https://github.com/foss-for-mips-arc-processors/uClibc.git"
CT_UCLIBC_NG_DEVEL_REVISION="d1fad636575c2a5c39c6ccdd72e57d46b3d1d622"
CT_LIBC_UCLIBC_LOCALES=y
CT_GCC_SRC_DEVEL=y
CT_GCC_DEVEL_URL="https://github.com/foss-for-mips-arc-processors/gcc.git"
CT_GCC_DEVEL_REVISION="6cdd8a9192b5c291d19d2893d6671829077680b7"
CT_CC_GCC_EXTRA_CONFIG_ARRAY="--with-gnu-as --with-gnu-ld"
# CT_CC_GCC_USE_GRAPHITE is not set
# CT_CC_GCC_ENABLE_TARGET_OPTSPACE is not set
CT_CC_LANG_CXX=y
CT_DEBUG_GDB=y
CT_GDB_SRC_DEVEL=y
CT_GDB_DEVEL_URL="https://github.com/foss-for-mips-arc-processors/binutils-gdb.git"
CT_GDB_DEVEL_REVISION="a476f6d73b2b5d4f76ef0e83584ee20f13b5c8a4"
# CT_GDB_CROSS_PYTHON is not set
